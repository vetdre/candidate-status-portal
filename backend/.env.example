PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Optional default webhook secret fallback
LEVER_WEBHOOK_SECRET=replace-me

# Per-webhook secrets (preferred)
LEVER_WEBHOOK_SECRET_APPLICATION_CREATED=replace-me
LEVER_WEBHOOK_SECRET_CANDIDATE_STAGE_CHANGE=replace-me
LEVER_WEBHOOK_SECRET_CANDIDATE_ARCHIVE_STATE_CHANGE=replace-me
LEVER_WEBHOOK_SECRET_INTERVIEW_CREATED=replace-me
LEVER_WEBHOOK_SECRET_INTERVIEW_UPDATED=replace-me
LEVER_WEBHOOK_SECRET_INTERVIEW_DELETED=replace-me

LEVER_API_BASE_URL=https://api.lever.co/v1
LEVER_API_KEY=replace-me
REPLAY_AUTH_TOKEN=replace-me

FF_INGEST_ENABLED=true
FF_ARCHIVE_ROUTE_ENABLED=true
FF_INTERVIEWS_ROUTE_ENABLED=true
FF_NORMALIZED_WRITES_ENABLED=true
FF_SHADOW_MATERIALIZE_ENABLED=true
FF_PARITY_JOB_ENABLED=false
FF_REPLAY_ENABLED=true
FF_DRY_RUN_MODE=false
FF_SYNC_PROCESSING_LOCAL=true
