{
  "rewrites": [
    {
      "source": "/lever-webhooks/interviews",
      "destination": "/api/webhooks/lever/interviews"
    },
    {
      "source": "/lever-webhooks/archive-state-change",
      "destination": "/api/webhooks/lever/archive-state-change"
    },
    {
      "source": "/lever-webhooks/application-created",
      "destination": "/api/webhooks/lever/application-created"
    },
    {
      "source": "/lever-webhooks/candidate-stage-change",
      "destination": "/api/webhooks/lever/candidate-stage-change"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://nnauvyublclfeqizpawr.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
